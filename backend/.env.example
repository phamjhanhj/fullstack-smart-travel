# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/smart_travel
ENVIRONMENT=development

# JWT
JWT_SECRET_KEY=change-this-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_SECONDS=3600
REFRESH_TOKEN_EXPIRE_SECONDS=604800

# Groq AI
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_ITINERARY_TEMPERATURE=0.2
GROQ_MAX_RETRIES=0
ITINERARY_TOTAL_TIMEOUT_SECONDS=55
ITINERARY_GROQ_TIMEOUT_SECONDS=23
ITINERARY_MAX_AI_CALLS=1
ITINERARY_MAX_CANDIDATES_SHORT=24
ITINERARY_MAX_CANDIDATES_LONG=32
ITINERARY_ONLINE_FALLBACK=false

# Route validation: haversine (offline) or osrm
ROUTING_PROVIDER=haversine
OSRM_BASE_URL=https://router.project-osrm.org

# Google Places (Locations module)
GOOGLE_PLACES_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# CORS
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8100

# Admin/debug access
ADMIN_EMAILS=admin@example.com

# Rate limits
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=12
RATE_LIMIT_SEARCH_PER_MINUTE=60
RATE_LIMIT_PHOTO_PER_MINUTE=40

# External API timeout
EXTERNAL_HTTP_TIMEOUT_SECONDS=10

# Gmail SMTP transactional email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=smart.travel.system.phenikaa@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
SMTP_FROM_EMAIL=smart.travel.system.phenikaa@gmail.com
SMTP_FROM_NAME=Smart Travel PKA
FRONTEND_BASE_URL=http://localhost:4200
